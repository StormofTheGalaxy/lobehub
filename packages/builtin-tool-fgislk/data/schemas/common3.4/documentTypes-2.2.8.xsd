    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/simple/types/2.2.2" schemaLocation="simpleTypes-2.2.2.xsd"/>
    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/address/types/2.1.3" schemaLocation="addressTypes-2.1.3.xsd"/>
    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/attachment/types/2.1.3" schemaLocation="attachmentTypes-2.1.3.xsd"/>
