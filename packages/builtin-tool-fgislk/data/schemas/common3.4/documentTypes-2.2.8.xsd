    <xs:complexType name="AttorneyDocumentStatusType">
        <xs:annotation>
            <xs:documentation>Документ, подтверждающий статус (должность) представителя</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="name" type="st:String1000SType">
                <xs:annotation>
                    <xs:documentation>Наименование</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="series" type="st:String25SType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Серия (при наличии)</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="number" type="st:String50SType">
                <xs:annotation>
                    <xs:documentation>Номер</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="issueName" type="st:String1000SType">
                <xs:annotation>
                    <xs:documentation>Кем выдан</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="issueDate" type="st:DateSType">
                <xs:annotation>
                    <xs:documentation>Дата выдачи</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="attachmentId" type="att:AttachmentIdRefSType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Идентификатор прилагаемого документа в описи</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="AttorneyDocumentCredentialsType">
        <xs:annotation>
            <xs:documentation>Документ, подтверждающий полномочия представителя</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="name" type="st:String1000SType">
                <xs:annotation>
                    <xs:documentation>Наименование</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="docDate" type="st:DateSType">
                <xs:annotation>
                    <xs:documentation>Дата выдачи</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="issuer" type="st:String1000SType">
                <xs:annotation>
                    <xs:documentation>Кем выдан</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="attestation" minOccurs="0" type="st:String4000SType">
                <xs:annotation>
                    <xs:documentation>Сведения об удостоверении документа, если он удостоверен</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="attachmentId" minOccurs="0" type="att:AttachmentIdRefSType">
                <xs:annotation>
                    <xs:documentation>Идентификатор прилагаемого документа в описи</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="PersonDocumentIdentityType">
        <xs:annotation>
            <xs:documentation>Документ, удостоверяющий личность</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="typesIdentityDoc" type="tns:TypesIdentityDocKindEType">
                <xs:annotation>
                    <xs:documentation>
                        Тип документа
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="series" type="st:String25SType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>
                        Серия
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="number" type="st:String50SType">
                <xs:annotation>
                    <xs:documentation>
                        Номер
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="issueName" type="st:String255SType">
                <xs:annotation>
                    <xs:documentation>
                        Наименование органа, выдавшего документ
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="issueDate" type="st:DateSType">
                <xs:annotation>
                    <xs:documentation>
                        Дата выдачи
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="issueCode" type="st:String8SType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>
                        Код подразделения органа, выдавшего документ
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ApplicantDocumentProvidedType">
        <xs:annotation>
            <xs:documentation>Документ, предоставленный заявителем</xs:documentation>
        </xs:annotation>
        <xs:sequence>
