            </xs:element>
            <xs:element name="amount" type="st:MoneySType">
                <xs:annotation>
                    <xs:documentation>Сумма</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="oktmo" type="addr:OktmoSType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>ОКТМО</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="accountNumber" type="st:AccountNumberSType">
                <xs:annotation>
                    <xs:documentation>Номер счета</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="corrAccountNumber" type="st:AccountNumberSType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Номер корреспондентского счета</xs:documentation>
