            </xs:element>
            <xs:element name="bankName" type="st:String255SType">
                <xs:annotation>
                    <xs:documentation>Наименование банка получателя</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="bik" type="st:BikSType">
                <xs:annotation>
                    <xs:documentation>БИК</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="FoundationDocumentType">
        <xs:annotation>
            <xs:documentation>Реквизиты документа-основания</xs:documentation>
