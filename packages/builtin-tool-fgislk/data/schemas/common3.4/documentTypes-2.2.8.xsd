    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/complex/types/2.1.3" schemaLocation="complexTypes-2.1.3.xsd"/>
    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/enums/documentType/types/2.1.9" schemaLocation="dDocumentTypeKindTypes-2.1.9.xsd"/>
