            <xs:element name="series" type="st:String25SType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Серия</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="number" type="st:String50SType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Номер</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="PaymentDocumentType">
        <xs:annotation>
            <xs:documentation>Платежный документ</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="name" type="st:String1000SType">
                <xs:annotation>
                    <xs:documentation>Наименование</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="docDate" type="st:DateSType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Дата выдачи</xs:documentation>
                </xs:annotation>
