    </xs:complexType>
    <xs:complexType name="DocumentTypeKindEType">
        <xs:annotation>
            <xs:documentation>Типы документов</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="code" type="dtype:DocumentTypeKindEType">
                <xs:annotation>
                    <xs:documentation>Код справочника</xs:documentation>
                </xs:annotation>
