                <xs:annotation>
                    <xs:documentation>Дата выдачи</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="TypesIdentityDocKindEType">
        <xs:annotation>
            <xs:documentation>Типы документов, удостоверяющих личность</xs:documentation>
