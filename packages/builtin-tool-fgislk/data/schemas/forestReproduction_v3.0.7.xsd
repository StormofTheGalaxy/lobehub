<?xml version="1.0" encoding="utf-8" ?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified"
    targetNamespace="http://rosleshoz.gov.ru/fgis-lk/forestReproduction/types/3.0.7"
    xmlns:tns="http://rosleshoz.gov.ru/fgis-lk/forestReproduction/types/3.0.7"
    xmlns:sub="http://rosleshoz.gov.ru/fgis-lk/common/enums/constituentEntity/types/2.1.1"
    xmlns:sa="http://rosleshoz.gov.ru/fgis-lk/common/enums/subordinateAuthority/types/2.1.4"
    xmlns:mesur="http://rosleshoz.gov.ru/fgis-lk/common/enums/measuresOZVL/types/2.1.2"
    xmlns:comR="http://rosleshoz.gov.ru/fgis-lk/common/commonReport/types/2.1.6"
    xmlns:st="http://rosleshoz.gov.ru/fgis-lk/common/simple/types/2.2.2"
    xmlns:attach="http://rosleshoz.gov.ru/fgis-lk/common/attachment/types/2.1.3"
    xmlns:contl="http://rosleshoz.gov.ru/fgis-lk/common/enums/contaminationLands/types/2.0"
    xmlns:address="http://rosleshoz.gov.ru/fgis-lk/common/address/types/2.1.3"
    xmlns:for="http://rosleshoz.gov.ru/fgis-lk/common/enums/forestry/types/2.2.3"
    xmlns:corsis="http://rosleshoz.gov.ru/fgis-lk/common/enums/coordinateSystem/types/2.2.1"
    xmlns:subfor="http://rosleshoz.gov.ru/fgis-lk/common/enums/districtForestries/types/2.1.5"
    xmlns:catforest="http://rosleshoz.gov.ru/fgis-lk/common/enums/categoryLandForestry/types/2.1.0"
    xmlns:unitm="http://rosleshoz.gov.ru/fgis-lk/common/enums/unitMeasurement/types/2.1.1">

    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/address/types/2.1.3"
        schemaLocation="common3.4/addressTypes-2.1.3.xsd"/>
    <xs:import
        namespace="http://rosleshoz.gov.ru/fgis-lk/common/enums/constituentEntity/types/2.1.1"
        schemaLocation="common3.4/dConstituentEntityKindTypes-2.1.1.xsd"/>
    <xs:import
        namespace="http://rosleshoz.gov.ru/fgis-lk/common/enums/subordinateAuthority/types/2.1.4"
        schemaLocation="common3.4/dSubordinateAuthorityKindTypes-2.1.4.xsd"/>
    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/enums/measuresOZVL/types/2.1.2"
        schemaLocation="common3.4/dMeasuresOZVLKindTypes-2.1.2.xsd"/>
    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/commonReport/types/2.1.6"
        schemaLocation="common3.4/commonReport-2.1.6.xsd"/>
    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/simple/types/2.2.2"
        schemaLocation="common3.4/simpleTypes-2.2.2.xsd"/>
    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/attachment/types/2.1.3"
        schemaLocation="common3.4/attachmentTypes-2.1.3.xsd"/>
    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/enums/forestry/types/2.2.3"
        schemaLocation="common3.4/dForestryKindTypes-2.2.3.xsd"/>
    <xs:import
        namespace="http://rosleshoz.gov.ru/fgis-lk/common/enums/districtForestries/types/2.1.5"
        schemaLocation="common3.4/dDistrictForestriesKindTypes-2.1.5.xsd"/>
    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/enums/coordinateSystem/types/2.2.1"
        schemaLocation="common3.4/dCoordinateSystemKindTypes-2.2.1.xsd"/>
    <xs:import
        namespace="http://rosleshoz.gov.ru/fgis-lk/common/enums/categoryLandForestry/types/2.1.0"
        schemaLocation="common3.4/dCategoryLandForestryKindTypes-2.1.0.xsd"/>
    <xs:import namespace="http://rosleshoz.gov.ru/fgis-lk/common/enums/unitMeasurement/types/2.1.1"
        schemaLocation="common3.4/dUnitMeasurementKindTypes-2.1.1.xsd"/>
    <xs:element name="forestReproduction" type="tns:ForestReproductionType">
        <xs:annotation>
            <xs:documentation>Отчёт о воспроизводстве лесов</xs:documentation>
        </xs:annotation>
    </xs:element>
    <xs:complexType name="NotePhotoVideoType">
        <xs:annotation>
            <xs:documentation>Фото-видео материалы примечания</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="nameContent" type="st:String4000SType">
                <xs:annotation>
                    <xs:documentation>Наименование фото-видео фиксации</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="dateContent" type="st:DateTimeSType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Дата и время фото-видео фиксации</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="coordinateContent" type="tns:CoordinateType">
                <xs:annotation>
                    <xs:documentation>Описание координат</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="fileID" type="attach:AttachmentIdRefSType" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>Идентификатор вложения</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="NotesType">
        <xs:annotation>
            <xs:documentation>Примечания</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="comment" type="st:String4000SType">
                <xs:annotation>
                    <xs:documentation>Комментарии</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="mobileTaskNo" type="st:String255SType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Номер мобильного задания</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="content" type="tns:NotePhotoVideoType">
                <xs:annotation>
                    <xs:documentation>Материалы фото-видео фиксации</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ServiceInfoType">
        <xs:annotation>
            <xs:documentation>Служебная информация услуги</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element minOccurs="0" name="provider" type="xs:string">
                <xs:annotation>
                    <xs:documentation>Идентификатор информационной системы поставщика данных</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="guid" type="st:GuidSType">
                <xs:annotation>
                    <xs:documentation>Уникальный идентификатор документа</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ForestReproductionType">
        <xs:sequence>
            <xs:element name="ID" type="xs:string" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Идентификатор отчета о воспроизводстве лесов</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="serviceInfo" type="tns:ServiceInfoType">
                <xs:annotation>
                    <xs:documentation>Служебная информация услуги</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="date" type="st:DateSType">
                <xs:annotation>
                    <xs:documentation>Дата составления документа</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="header">
                <xs:annotation>
                    <xs:documentation>Общие сведения об отчете</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="subject" type="sub:ConstituentEntityKindEType">
                            <xs:annotation>
                                <xs:documentation>Субъект РФ</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="categoryLand"
                            type="catforest:CategoryLandForestryKindEType" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Категории земель</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="executiveAuthority"
                            type="sa:SubordinateAuthorityKindEType">
                            <xs:annotation>
                                <xs:documentation>Наименование органа государственной власти, органа местного
                                    самоуправления
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="period" type="comR:PeriodType">
                            <xs:annotation>
                                <xs:documentation>Период действия документа</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="partner" type="comR:ForestUserType">
                            <xs:annotation>
                                <xs:documentation>Отправитель документа</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="signerData" type="comR:SignerDataType">
                            <xs:annotation>
                                <xs:documentation>Подписант документа</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="contract" type="comR:ContractType">
                            <xs:annotation>
                                <xs:documentation>Договор</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
            <xs:choice>
                <xs:element name="forest" type="tns:ForestReproductionInfoType">
                    <xs:annotation>
                        <xs:documentation>Информация о землях лесного фонда</xs:documentation>
                    </xs:annotation>
                </xs:element>
                <xs:element name="agriculture" type="tns:AgriculReproductionInfoType">
                    <xs:annotation>
                        <xs:documentation>Информация о землях сельскохозяйственного назначения</xs:documentation>
                    </xs:annotation>
                </xs:element>
            </xs:choice>
            <xs:element name="attachments" type="attach:AttachmentListType">
                <xs:annotation>
                    <xs:documentation>Присоединенные файлы</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ForestReproductionInfoType">
        <xs:annotation>
            <xs:documentation>Информация о землях лесного фонда</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="forestry" type="for:ForestryKindEType">
                <xs:annotation>
                    <xs:documentation>Наименование или учетный номер лесничества</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="reproduction">
                <xs:annotation>
                    <xs:documentation>Мероприятия по воспроизводству лесов</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="row" type="tns:ForestRowType" maxOccurs="unbounded"
                            minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Информация о мероприятиях по воспроизводству лесов</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="AgriculReproductionInfoType">
        <xs:annotation>
            <xs:documentation>Информация о землях сельскохозяйственного назначения</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="municipalDistrict" type="address:OktmoSType">
                <xs:annotation>
                    <xs:documentation>Муниципальный район</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="reproduction">
                <xs:annotation>
                    <xs:documentation>Мероприятия по воспроизводству лесов</xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="row" type="tns:AgriRowType" maxOccurs="unbounded"
                            minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Информация о мероприятиях по воспроизводству лесов</xs:documentation>
                            </xs:annotation>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ForestRowType">
        <xs:annotation>
            <xs:documentation>Информация о мероприятиях по воспроизводству лесов</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="numberLine" type="xs:string">
                <xs:annotation>
                    <xs:documentation>№ п/п</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="reportRate" type="mesur:MeasuresOZVLKindEType">
                <xs:annotation>
                    <xs:documentation>Показатель отчета</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="codeLine" type="st:PositiveSType">
                <xs:annotation>
                    <xs:documentation>Код строки отчета</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="tree" type="comR:TreeType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Порода (Указывается элемент справочника "Породы древесины")</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="typeLocation" type="tns:LocationType">
                <xs:annotation>
                    <xs:documentation>Местоположение</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="unitType" type="unitm:UnitMeasurementKindEType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Единица измерения</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="value" type="st:PositiveDecimalSType">
                <xs:annotation>
                    <xs:documentation>Объем выполненных мероприятий</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="year" type="st:DateYearSType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Год выполнения мероприятий</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="tns:NotesType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Примечание</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="AgriRowType">
        <xs:annotation>
            <xs:documentation>Информация о мероприятиях по воспроизводству лесов</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="numberLine" type="xs:string">
                <xs:annotation>
                    <xs:documentation>№ п/п</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="reportRate" type="mesur:MeasuresOZVLKindEType">
                <xs:annotation>
                    <xs:documentation>Показатель отчета</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="codeLine" type="st:PositiveSType">
                <xs:annotation>
                    <xs:documentation>Код строки отчета</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="tree" type="comR:TreeType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Порода (Указывается элемент справочника "Породы древесины")</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="cadastralNumber" type="st:String25SType">
                <xs:annotation>
                    <xs:documentation>Кадастровый номер </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="unitType" type="unitm:UnitMeasurementKindEType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Единица измерения</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="value" type="st:PositiveDecimalSType">
                <xs:annotation>
                    <xs:documentation>Объем выполненных мероприятий</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="year" type="st:DateYearSType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Год выполнения мероприятий</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="notes" type="tns:NotesType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Примечание</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ExplicationType">
        <xs:annotation>
            <xs:documentation>Экспликация объекта</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="row" type="tns:ExplicationRowType" maxOccurs="unbounded">
                <xs:annotation>
                    <xs:documentation>Информация о координатах</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="ExplicationRowType">
        <xs:annotation>
            <xs:documentation>Информация о координатах</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="numberPoint" type="st:PositiveSType">
                <xs:annotation>
                    <xs:documentation>Номер точки</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="longitude" type="xs:decimal">
                <xs:annotation>
                    <xs:documentation>Долгота (X)</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="latitude" type="xs:decimal">
                <xs:annotation>
                    <xs:documentation>Широта (Y)</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="description" type="st:String255SType">
                <xs:annotation>
                    <xs:documentation>Описание </xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="BindingType">
        <xs:annotation>
            <xs:documentation>Привязка объекта</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element maxOccurs="unbounded" name="row" type="tns:ExplicationRowType">
                <xs:annotation>
                    <xs:documentation>Информация о координатах</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="CoordinateType">
        <xs:annotation>
            <xs:documentation>Координаты</xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="CsCode" type="corsis:CoordinateSystemKindEType">
                <xs:annotation>
                    <xs:documentation>Системы координат ведения пространственных данных ГЛР</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="binding" type="tns:BindingType">
                <xs:annotation>
                    <xs:documentation>Привязка объекта</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="explication" type="tns:ExplicationType">
                <xs:annotation>
                    <xs:documentation>Экспликация объекта</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="LocationType">
        <xs:sequence>
            <xs:element minOccurs="0" name="subforestry" type="subfor:DistrictForestriesKindEType">
                <xs:annotation>
                    <xs:documentation>Наименование и учетный номер участкового лесничества
                    </xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="tract" type="st:String255SType">
                <xs:annotation>
                    <xs:documentation>Наименование урочища (при наличии)</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="quarter" type="st:String25SType">
                <xs:annotation>
                    <xs:documentation>N Лесного квартала</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="choice" type="tns:TaxationType">
                <xs:annotation>
                    <xs:documentation>№ лесотаксационного выдела или координаты</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="cuttingArea" type="st:String25SType">
                <xs:annotation>
                    <xs:documentation>Номер лесосеки</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element name="comment" type="st:String4000SType" minOccurs="0">
                <xs:annotation>
                    <xs:documentation>Примечание к местоположению</xs:documentation>
                </xs:annotation>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
    <xs:complexType name="TaxationType">
        <xs:annotation>
            <xs:documentation>№ лесотаксационного выдела/Координаты</xs:documentation>
        </xs:annotation>
        <xs:choice>
            <xs:element minOccurs="0" name="taxationUnit" type="st:String25SType">
                <xs:annotation>
                    <xs:documentation>№ лесотаксационного выдела</xs:documentation>
                </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" name="coordinate" type="tns:CoordinateType"/>
        </xs:choice>
    </xs:complexType>
</xs:schema>
